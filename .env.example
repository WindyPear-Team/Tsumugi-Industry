# HTTP listener
HOST=0.0.0.0
PORT=8080

# Supported: sqlite, mysql, postgres
DB_DRIVER=sqlite
DB_DSN=./data/tsumugi.db

# MySQL example:
# DB_DRIVER=mysql
# DB_DSN=user:password@tcp(127.0.0.1:3306)/tsumugi?charset=utf8mb4&parseTime=True&loc=Local

# PostgreSQL example:
# DB_DRIVER=postgres
# DB_DSN=host=127.0.0.1 user=postgres password=postgres dbname=tsumugi port=5432 sslmode=disable TimeZone=Asia/Shanghai
